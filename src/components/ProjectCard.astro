---
import { Picture } from "astro:assets";
import type { CollectionEntry } from "astro:content";
interface Props {
  project: CollectionEntry<"projects">;
  headingLevel?: 2 | 3;
}
const { project, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as const;
const id = project.id;
// Only app icons are small enough to sit in a card; screenshots stay on the detail page.
const icon = project.data.imageStyle === "icon" ? project.data.cover : undefined;
---

<a href={`/projects/${id}/`} class="project-card" aria-labelledby={`project-${id}-title`}>
  {icon && (
    <Picture
      class="project-icon"
      src={icon.src}
      alt=""
      widths={[64, 128]}
      sizes="64px"
      formats={["avif", "webp"]}
      loading="lazy"
    />
  )}
  <p class="project-category">{project.data.category}</p>
  <Heading id={`project-${id}-title`}>{project.data.title}</Heading>
  <p class="project-description">{project.data.description}</p>
  <p class="project-stack">
    <span class="visually-hidden">Built with </span>
    {project.data.stack.join(", ")}
  </p>
</a>
<style>
  .project-card {
    display: block;
    min-width: 0;
  }
  .project-card:hover {
    color: inherit;
  }
  .project-card:hover h2,
  .project-card:hover h3 {
    color: var(--accent);
  }
  .project-card :global(.project-icon) {
    width: 56px;
    height: 56px;
    margin-bottom: 1.1rem;
    border-radius: 13px;
    filter: drop-shadow(0 6px 10px rgb(0 0 0 / 0.18));
    transition: transform 200ms ease;
  }
  .project-card:hover :global(.project-icon) {
    transform: translateY(-2px);
  }
  .project-category {
    font-size: 0.875rem;
    color: var(--muted);
    margin: 0 0 0.5rem;
  }
  h2,
  h3 {
    font-size: 1.45rem;
    margin: 0;
    transition: color 150ms;
  }
  .project-description {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.65;
    max-width: 48ch;
    margin: 0.75rem 0 0.9rem;
  }
  .project-stack {
    font-size: 0.85rem;
    color: var(--muted);
    margin: 0;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
