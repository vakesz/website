---
import type { CollectionEntry } from "astro:content";
import ProjectVisual from "./ProjectVisual.astro";
interface Props {
  project: CollectionEntry<"projects">;
  headingLevel?: 2 | 3;
}
const { project, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as const;
const id = project.id;
---

<a
  href={`/projects/${id}/`}
  class:list={["project-card", id, !project.data.cover && "text-only"]}
  aria-labelledby={`project-${id}-title`}
>
  {project.data.cover && <ProjectVisual project={project} />}
  <div class="project-details">
    <div class="project-title">
      <Heading id={`project-${id}-title`}>{project.data.title}</Heading><span aria-hidden="true"
        >↗</span
      >
    </div><p class="project-description">{project.data.description}</p><ul
      class="project-stack"
      aria-label="Technology stack"
    >
      {project.data.stack.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</a>
<style>
  .project-card {
    display: block;
    min-width: 0;
  }
  .project-card:hover :global(.project-art) {
    transform: translateY(-3px);
  }
  .project-category {
    margin: 1.5rem 0 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
  }
  .project-details {
    padding-top: 1.2rem;
  }
  .text-only {
    border-top: 1px solid var(--border);
    padding-top: 0.5rem;
  }
  .project-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .project-title h2,
  .project-title h3 {
    font-size: 1.45rem;
    margin: 0;
  }
  .project-title > span {
    font-size: 1.3rem;
  }
  .project-description {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.65;
    max-width: 48ch;
    margin: 0.75rem 0 1rem;
  }
  .project-stack {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.85rem;
    padding: 0;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }
  .project-stack li + li {
    position: relative;
  }
  .project-stack li + li:before {
    content: "·";
    position: absolute;
    left: -0.55rem;
  }
  @media (max-width: 760px) {
    .project-category {
      margin-top: 1.2rem;
    }
  }
</style>
