---
import type { CollectionEntry } from "astro:content";
interface Props {
  project: CollectionEntry<"projects">;
  headingLevel?: 2 | 3;
}
const { project, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as const;
const id = project.id;
---

<a href={`/projects/${id}/`} class="project-card" aria-labelledby={`project-${id}-title`}>
  <p class="project-category">{project.data.category}</p>
  <Heading id={`project-${id}-title`}>{project.data.title}</Heading>
  <p class="project-description">{project.data.description}</p>
  <p class="project-stack">
    <span class="visually-hidden">Built with </span>
    {project.data.stack.join(", ")}
  </p>
</a>
<style>
  .project-card {
    display: block;
    min-width: 0;
  }
  .project-card:hover {
    color: inherit;
  }
  .project-card:hover h2,
  .project-card:hover h3 {
    color: var(--accent);
  }
  .project-category {
    font-size: 0.875rem;
    color: var(--muted);
    margin: 0 0 0.5rem;
  }
  h2,
  h3 {
    font-size: 1.45rem;
    margin: 0;
    transition: color 150ms;
  }
  .project-description {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.65;
    max-width: 48ch;
    margin: 0.75rem 0 0.9rem;
  }
  .project-stack {
    font-size: 0.85rem;
    color: var(--muted);
    margin: 0;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
