---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "./FormattedDate.astro";
interface Props {
  post: CollectionEntry<"posts">;
  headingLevel?: 2 | 3;
}
const { post, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as const;
---

<a class="post-card" href={`/posts/${post.id}/`} aria-labelledby={`post-${post.id}-title`}>
  <div class="post-meta">
    <FormattedDate date={post.data.pubDate} short />
    <span>{post.data.tags[0] ?? "notes"}</span>
  </div>
  <div class="post-copy">
    <Heading id={`post-${post.id}-title`}>{post.data.title}</Heading>
    <p>{post.data.description}</p>
  </div>
</a>
<style>
  /* Date gutter on the left, title and summary at reading width beside it.
     Items are separated by space alone; no rules. */
  .post-card {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: 0 1.5rem;
    align-items: baseline;
  }
  .post-card + :global(.post-card) {
    margin-top: 2.75rem;
  }
  .post-meta {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 0.85rem;
    line-height: 1.4;
    color: var(--muted);
  }
  .post-meta :global(time) {
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  h2,
  h3 {
    font-size: 1.3rem;
    line-height: 1.35;
    margin: 0;
    transition: color 150ms;
  }
  .post-card:hover h2,
  .post-card:hover h3 {
    color: var(--accent);
  }
  p {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--muted);
    max-width: 65ch;
    margin: 0.5rem 0 0;
  }
  @media (max-width: 760px) {
    .post-card {
      grid-template-columns: 1fr;
    }
    .post-card + :global(.post-card) {
      margin-top: 2.25rem;
    }
    .post-meta {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0 0.75rem;
      margin-bottom: 0.4rem;
    }
  }
</style>
