---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "./FormattedDate.astro";
interface Props {
  post: CollectionEntry<"posts">;
  headingLevel?: 2 | 3;
}
const { post, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as const;
---

<a class="post-card" href={`/posts/${post.id}/`} aria-labelledby={`post-${post.id}-title`}>
  <div class="post-meta">
    <span>{post.data.tags[0] ?? "Notes"}</span>
    <FormattedDate date={post.data.pubDate} short />
  </div>
  <div class="post-title">
    <Heading id={`post-${post.id}-title`}>{post.data.title}</Heading>
  </div>
  <p>{post.data.description}</p>
</a>
<style>
  .post-card {
    display: block;
    padding: 1.55rem 0;
    border-bottom: 1px solid var(--border);
  }
  .post-card:first-child {
    padding-top: 0;
  }
  .post-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.75rem;
    font-family: var(--font-sans);
    color: var(--muted);
    margin-bottom: 0.8rem;
  }
  .post-meta > span {
    letter-spacing: 0;
  }
  .post-title {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .post-title h2,
  .post-title h3 {
    font-size: 1.3rem;
    line-height: 1.35;
    margin: 0;
  }
  .post-card p {
    font-size: 0.925rem;
    line-height: 1.7;
    color: var(--muted);
    max-width: 65ch;
    margin: 0.65rem 0 0;
  }
  .post-card:hover .post-title {
    color: var(--accent);
  }
</style>
