---
import { SITE, SOCIAL, TWITTER_HANDLE } from "../consts";
import type { PageMetadata } from "../lib/page-metadata";

interface Props {
  metadata: PageMetadata;
}

const { metadata } = Astro.props;
const { title, description = SITE.description } = metadata;
const image = metadata.image ?? { src: "/og/site.png", alt: SITE.title };
const article = metadata.kind === "article" ? metadata : null;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL(image.src, Astro.site).toString();
const fullTitle = title === SITE.title ? title : `${title} · ${SITE.title}`;

const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE.author,
  url: Astro.site?.toString(),
  email: `mailto:${SITE.email}`,
  jobTitle: SITE.jobTitle,
  description: SITE.description,
  worksFor: {
    "@type": "Organization",
    name: SITE.employer,
    url: SITE.employerUrl,
  },
  sameAs: [SOCIAL.github, SOCIAL.twitter, SOCIAL.linkedin, SOCIAL.youtube, SOCIAL.instagram],
};

const articleLd = article
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: title,
      description,
      url: canonical,
      image: ogImage,
      datePublished: article.pubDate.toISOString(),
      dateModified: (article.updatedDate ?? article.pubDate).toISOString(),
      keywords: article.tags?.join(", "),
      ...(article.tags?.length ? { articleSection: article.tags[0] } : {}),
      ...(article.wordCount ? { wordCount: article.wordCount } : {}),
      inLanguage: SITE.locale.split("_")[0],
      mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
      author: { "@type": "Person", name: SITE.author, url: Astro.site?.toString() },
      publisher: { "@type": "Person", name: SITE.author, url: Astro.site?.toString() },
    }
  : null;

// JSON-LD is data, but it still sits inside a script element. Escaping `<`
// prevents content such as `</script>` from terminating that element.
const jsonLd = (value: object) => JSON.stringify(value).replaceAll("<", "\\u003c");
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
{!metadata.robots && <link rel="canonical" href={canonical} />}

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={SITE.author} />
{metadata.robots && <meta name="robots" content={metadata.robots} />}

<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#fcfcfc" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#141718" media="(prefers-color-scheme: dark)" />

<meta property="og:type" content={article ? "article" : "website"} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={image.alt} />
<meta property="og:locale" content={SITE.locale} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={TWITTER_HANDLE} />
<meta name="twitter:creator" content={TWITTER_HANDLE} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={image.alt} />

{article && <meta property="article:published_time" content={article.pubDate.toISOString()} />}
{
  article && (
    <meta
      property="article:modified_time"
      content={(article.updatedDate ?? article.pubDate).toISOString()}
    />
  )
}
{article && <meta property="article:author" content={SITE.author} />}
{article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}

<link rel="alternate" type="application/rss+xml" title={`${SITE.title} · RSS`} href="/rss.xml" />
<link rel="sitemap" href="/sitemap-index.xml" />

<script type="application/ld+json" is:inline set:html={jsonLd(personLd)} />
{articleLd && <script type="application/ld+json" is:inline set:html={jsonLd(articleLd)} />}

<script is:inline src="/document-init.js"></script>
