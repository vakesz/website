---
interface Props {
  title: string;
  lede?: string;
  align?: "left" | "center";
}
const { title, lede, align = "left" } = Astro.props;
const hasLede = Boolean(lede) || Astro.slots.has("lede");
---

<header class:list={["page-header", align]}>
  <h1>{title}</h1>
  {hasLede && (
    <p class="lede">
      <slot name="lede">{lede}</slot>
    </p>
  )}
  <slot />
</header>
