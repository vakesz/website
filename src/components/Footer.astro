---
import { SITE, SOCIAL } from "../consts";
const year = new Date().getUTCFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div>
      <a class="footer-brand" href="/">vakesz<span>.</span></a><p>
        © {year}
        {SITE.author} · Budapest, Hungary
      </p>
    </div><nav aria-label="Footer">
      <a href={SOCIAL.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a><a
        href={SOCIAL.linkedin}
        target="_blank"
        rel="noopener noreferrer">LinkedIn ↗</a
      ><a href={`mailto:${SITE.email}`}>Email ↗</a><a href="/rss.xml">RSS</a><a href="/admin/"
        >Admin</a
      >
    </nav>
  </div>
</footer>
<style>
  .site-footer {
    border-top: 1px solid var(--border);
    margin-top: 4rem;
    padding: 2.5rem 0;
  }
  .footer-inner {
    max-width: var(--content-wide);
    width: calc(100% - 6rem);
    margin: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
  }
  .footer-brand {
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: -0.06em;
  }
  .footer-brand span {
    color: var(--accent);
  }
  p {
    font-size: 0.75rem;
    color: var(--muted);
    margin: 0.35rem 0 0;
  }
  nav {
    display: flex;
    gap: 1.4rem;
    flex-wrap: wrap;
    font-size: 0.825rem;
  }
  nav a {
    padding: 0.5rem 0;
  }
  @media (max-width: 760px) {
    .footer-inner {
      width: calc(100% - 2.5rem);
      flex-direction: column;
      align-items: flex-start;
    }
    .site-footer {
      margin-top: 3rem;
    }
    nav {
      gap: 1.3rem;
    }
  }
</style>
