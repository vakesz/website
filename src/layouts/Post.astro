---
import { Picture } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Base from "./Base.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { tagSlug } from "../lib/content";

interface Props {
  post: CollectionEntry<"posts">;
  minutesRead?: number;
  wordCount?: number;
}

const { post, minutesRead, wordCount } = Astro.props;
const { title, description, pubDate, updatedDate, tags, cover } = post.data;
const ogImage = `/og/${post.id}.png`;
---

<Base
  metadata={{
    kind: "article",
    title,
    description,
    image: { src: ogImage, alt: title },
    pubDate,
    updatedDate,
    tags,
    wordCount,
  }}
>
  <a class="back-link" href="/posts/">← Blog</a>
  <article class="prose post">
    <header class="post-header page-header">
      <h1>{title}</h1>
      <p class="post-meta">
        <FormattedDate date={pubDate} />
        {
          minutesRead && (
            <>
              <span class="dot" aria-hidden="true">
                ·
              </span>
              <span>{minutesRead} min read</span>
            </>
          )
        }
        {
          updatedDate && (
            <>
              <span class="dot" aria-hidden="true">
                ·
              </span>
              <span>
                updated <FormattedDate date={updatedDate} />
              </span>
            </>
          )
        }
      </p>
    </header>

    {
      cover && (
        <figure class="cover">
          <Picture
            src={cover.src}
            alt={cover.alt}
            widths={[640, 880, 1280, 1760]}
            sizes="(max-width: 880px) 100vw, 880px"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            formats={["avif", "webp"]}
          />
          {cover.caption && <figcaption>{cover.caption}</figcaption>}
        </figure>
      )
    }

    <div class="post-body">
      <slot />
    </div>

    {
      tags.length > 0 && (
        <ul class="tag-list" aria-label="Tags">
          {tags.map((t) => (
            <li>
              <a href={`/tags/${tagSlug(t)}/`}>#{t}</a>
            </li>
          ))}
        </ul>
      )
    }

    <slot name="after" />
  </article>
</Base>

<style>
  .post {
    /* Cover bleeds 0.5rem either side; contain any other accidental overflow. */
    overflow-x: clip;
  }
  .post-header {
    margin-bottom: 1.25rem;
  }
  .post-header h1 {
    margin-bottom: 0.5rem;
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--muted);
    margin: 0;
  }
  .cover {
    margin: 2rem 0 3rem;
  }
  .cover :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }
  .cover figcaption {
    margin-top: 0.5rem;
    text-align: center;
    color: var(--muted);
    font-size: 0.86rem;
  }
  .tag-list {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .tag-list a {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
    text-decoration: none;
  }
  .tag-list a:hover {
    color: var(--ink);
    border-color: var(--accent);
  }
</style>
