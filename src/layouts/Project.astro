---
import type { CollectionEntry } from "astro:content";
import Base from "./Base.astro";
import ProjectCover from "../components/ProjectCover.astro";
interface Props {
  project: CollectionEntry<"projects">;
}
const { project } = Astro.props;
const { title, description, repo, homepage, stack, category, archived } = project.data;
---

<Base metadata={{ kind: "page", title, description }}>
  <a class="back-link" href="/projects/">
    ← Projects
  </a>
  <article>
    <header class="project-header">
      <div>
        <h1>{title}</h1>
        <p class="lede">{description}</p>
      </div>
      <div class="project-actions">
        {homepage && (
          <a class="btn btn-primary" href={homepage} target="_blank" rel="noopener noreferrer">
            Visit website ↗
          </a>
        )}
        {repo && (
          <a class="btn" href={repo} target="_blank" rel="noopener noreferrer">
            Source code ↗
          </a>
        )}
      </div>
    </header>
    {project.data.cover && <ProjectCover project={project} large />}
    <div class="project-body">
      <aside>
        <dl>
          <div>
            <dt>Project</dt>
            <dd>{category}</dd>
          </div>
          <div>
            <dt>Built with</dt>
            <dd>{stack.join(", ")}</dd>
          </div>
          {archived && (
            <div>
              <>
                <dt>Status</dt>
                <dd>Archived</dd>
              </>
            </div>
          )}
        </dl>
      </aside>
      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</Base>
<style>
  .project-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 3rem;
    margin-bottom: 2.5rem;
  }
  .project-header h1 {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    margin: 0 0 1.2rem;
  }
  .project-header .lede {
    max-width: 48ch;
    margin: 0;
  }
  .project-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: flex-end;
    flex-shrink: 0;
  }
  .project-body {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 4rem;
    margin-top: 3rem;
  }
  .project-body .prose {
    max-width: 64ch;
  }
  .project-body dt {
    font-size: 0.875rem;
    color: var(--muted);
    margin-bottom: 0.4rem;
  }
  .project-body dd {
    margin: 0;
    font-size: 1rem;
  }
  .project-body dl {
    margin: 0;
  }
  .project-body dl > div {
    margin-bottom: 1.5rem;
  }
  @media (max-width: 900px) {
    .project-header {
      display: block;
    }
    .project-actions {
      margin-top: 1.5rem;
      justify-content: flex-start;
    }
    .project-body {
      grid-template-columns: 180px minmax(0, 1fr);
      gap: 2rem;
    }
  }
  @media (max-width: 760px) {
    .project-body {
      grid-template-columns: 1fr;
      gap: 1rem;
      margin-top: 2rem;
    }
    .project-body dl {
      display: flex;
      gap: 2rem;
      flex-wrap: wrap;
    }
    .project-body dl > div {
      max-width: 100%;
    }
  }
</style>
