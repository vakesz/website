---
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import PostCard from "../components/PostCard.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { SITE } from "../consts";
import { loadPostCatalog, loadProjects } from "../lib/content";
import me from "../assets/me.jpg";
import home from "../data/home.json";
const projects = (await loadProjects()).filter((p) => p.data.pinned).slice(0, 2);
const posts = (await loadPostCatalog()).posts.slice(0, 3);
---

<Base
  metadata={{
    kind: "page",
    title: SITE.title,
    description: SITE.description,
  }}
>
  <section class="hero">
    <div class="hero-copy">
      <h1>
        {home.headline} <span class="accent">{home.headlineAccent}</span>
      </h1>
      <p class="hero-lede">{home.introduction}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/posts/">
          Read the blog
        </a>
        <a class="btn" href="/projects/">
          Projects
        </a>
      </div>
      <div class="hero-links">
        <SocialLinks variant="inline" only={["github", "linkedin"]} />
      </div>
    </div>
    <figure class="hero-portrait">
      <Picture
        src={me}
        alt="Gábor Pinkova on a forest trail"
        widths={[320, 640, 960]}
        sizes="(max-width:760px) 112px, 290px"
        formats={["avif", "webp"]}
        loading="eager"
        fetchpriority="high"
      />
    </figure>
  </section>
  <section class="section-block">
    <div class="section-heading">
      <h2>Projects</h2>
      <a class="text-link" href="/projects/">
        All projects
      </a>
    </div>
    <div class="grid-2">
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>
  <section class="section-block">
    <div class="section-heading">
      <h2>Writing</h2>
      <a class="text-link" href="/posts/">
        All posts
      </a>
    </div>
    <div class="home-posts">
      {posts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  </section>
</Base>
<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 290px;
    gap: 5rem;
    align-items: center;
    padding: 0.4rem 0 4.8rem;
  }
  .hero h1 {
    max-width: 11ch;
    font-size: clamp(3.5rem, 7.2vw, 6rem);
    line-height: 0.98;
    margin: 0 0 1.6rem;
    letter-spacing: -0.065em;
  }
  .hero-lede {
    font-size: 1.075rem;
    max-width: 48ch;
    line-height: 1.75;
    color: var(--muted);
    margin: 0 0 1.9rem;
  }
  .hero-actions {
    display: flex;
    gap: 1.6rem;
    flex-wrap: wrap;
    align-items: center;
  }
  .hero-links {
    display: flex;
    gap: 1.35rem;
    font-size: 0.8rem;
    color: var(--muted);
    margin-top: 1.5rem;
  }
  .hero-portrait {
    margin: 0;
    width: 100%;
    padding-top: 0;
  }
  .hero-portrait :global(img) {
    aspect-ratio: 4/5;
    object-fit: cover;
    object-position: 50% 50%;
    border-radius: var(--radius);
  }
  @media (max-width: 1000px) {
    .hero {
      gap: 2.5rem;
      grid-template-columns: minmax(0, 1fr) 250px;
    }
    .hero h1 {
      font-size: 4.8rem;
    }
  }
  @media (max-width: 760px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 1.75rem;
      padding: 0 0 3rem;
    }
    .hero h1 {
      font-size: clamp(2.75rem, 13vw, 4.5rem);
      letter-spacing: -0.05em;
      margin-bottom: 1.25rem;
    }
    .hero-portrait {
      width: 112px;
      grid-row: 1;
    }
    .hero-portrait :global(img) {
      aspect-ratio: 1;
      object-position: 50% 10%;
    }
    .hero-actions {
      gap: 1rem;
    }
    .hero-links {
      margin-top: 1.1rem;
    }
    .hero-lede {
      font-size: 1rem;
    }
  }
</style>
