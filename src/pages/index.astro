---
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SocialIcons from "../components/SocialIcons.astro";
import { SITE } from "../consts";
import { loadPostCatalog, loadProjects } from "../lib/content";
import mePhoto from "../assets/me.jpg";

const recentPosts = (await loadPostCatalog()).posts.slice(0, 4);
const featuredProjects = (await loadProjects()).filter(({ data }) => !data.archived).slice(0, 4);
---

<Base metadata={{ kind: "page", title: SITE.title, description: SITE.description }} width="wide">
  <section class="hero">
    <div class="hero-copy">
      <h1>Hello, I’m <span class="gradient">Gábor.</span></h1>
      <p class="lede">
        Software engineer at <strong translate="no">Sigma Technology</strong> in Budapest. Six years on
        automotive software before that. Off the clock: forests and trails over screens.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/posts/">Read the blog</a>
        <a class="btn" href="/projects/">Projects</a>
      </div>
      <SocialIcons />
    </div>

    <div class="hero-photo">
      <Picture
        src={mePhoto}
        alt="Gábor Pinkova"
        widths={[260, 420, 840]}
        sizes="(max-width: 820px) 260px, 420px"
        loading="eager"
        decoding="async"
        fetchpriority="high"
        formats={["avif", "webp"]}
      />
    </div>
  </section>

  <div class="section-title reveal">
    <h2>Latest <span class="gradient">posts</span></h2>
    <a href="/posts/">View all →</a>
  </div>
  <div class="stack reveal">
    {recentPosts.map((post) => <PostCard post={post} />)}
  </div>

  <div class="section-title reveal">
    <h2>Selected <span class="gradient">projects</span></h2>
    <a href="/projects/">View all →</a>
  </div>
  <div class="grid-2 reveal">
    {featuredProjects.map((project) => <ProjectCard project={project} />)}
  </div>

  <script>
    import "../scripts/reveal";
  </script>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 3rem;
    align-items: center;
    padding: 2rem 0 3.5rem;
    position: relative;
  }
  .hero::before {
    content: "";
    position: absolute;
    inset: -10% -5% -10% -5%;
    background:
      radial-gradient(
        40% 50% at 20% 30%,
        color-mix(in oklab, var(--accent) 18%, transparent),
        transparent 70%
      ),
      radial-gradient(
        35% 45% at 80% 70%,
        color-mix(in oklab, var(--accent-2) 18%, transparent),
        transparent 70%
      );
    filter: blur(40px);
    z-index: -1;
    opacity: 0.9;
    pointer-events: none;
  }

  .hero h1 {
    font-size: clamp(2.1rem, 5.5vw, 3.4rem);
    letter-spacing: -0.035em;
    line-height: 1.05;
    margin: 0 0 1.1rem;
    font-weight: 700;
  }

  .hero .lede {
    font-size: 1.08rem;
    line-height: 1.65;
    color: var(--muted);
    margin: 0 0 1.6rem;
    max-width: 52ch;
  }
  .hero .lede strong {
    color: var(--ink);
    font-weight: 600;
  }

  .hero-actions {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-bottom: 1.6rem;
  }

  .hero-photo {
    position: relative;
    justify-self: center;
    width: min(420px, 100%);
    aspect-ratio: 1 / 1;
  }
  .hero-photo img {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 28px;
    border: 1px solid var(--border);
    box-shadow:
      0 30px 60px -20px color-mix(in oklab, var(--accent) 35%, transparent),
      0 20px 40px -20px color-mix(in oklab, var(--accent-2) 35%, transparent);
    z-index: 1;
  }

  .section-title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin: 2.5rem 0 1rem;
    gap: 1rem;
  }
  .section-title h2 {
    font-size: 1.35rem;
    text-transform: none;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0;
    font-weight: 700;
  }
  .section-title a {
    font-size: 0.85rem;
    font-family: var(--font-mono);
    color: var(--muted);
    white-space: nowrap;
  }
  .section-title a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  :global(html.js) .reveal {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 240ms ease,
      transform 240ms ease;
  }
  :global(html.js) .reveal.is-visible {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 1rem 0 2.5rem;
    }
    .hero-photo {
      order: -1;
      justify-self: start;
      width: min(280px, 62%);
    }
  }

  @media (max-width: 520px) {
    .hero {
      gap: 1.35rem;
      padding: 0.5rem 0 2rem;
    }
    .hero h1 {
      font-size: clamp(1.85rem, 10vw, 2.35rem);
      margin-bottom: 0.9rem;
    }
    .hero .lede {
      font-size: 1rem;
      line-height: 1.58;
      margin-bottom: 1.2rem;
    }
    .hero-actions {
      margin-bottom: 1.2rem;
    }
    .hero-photo {
      justify-self: center;
      width: min(220px, 72%);
    }
  }

  @media (max-width: 640px) {
    .section-title {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.35rem;
      margin: 2rem 0 0.9rem;
    }
    .section-title a {
      font-size: 0.82rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
