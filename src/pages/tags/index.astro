---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import { loadPostCatalog } from "../../lib/content";

const { posts, tags } = await loadPostCatalog();
---

<Base
  metadata={{
    kind: "page",
    title: "Tags",
    description: "All tags used across posts on vakesz.com.",
  }}
>
  <PageHeader
    eyebrow="Browse"
    title="All"
    accented="tags."
    lede={`${tags.length} tags across ${posts.length} posts.`}
  />

  <ul class="tag-cloud">
    {
      tags.map(({ slug, label, posts: entries }) => (
        <li>
          <a href={`/tags/${slug}/`}>
            <span>#{label}</span>
            <span class="count">{entries.length}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .tag-cloud {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .tag-cloud a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    text-decoration: none;
  }
  .tag-cloud a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .count {
    color: var(--muted);
    font-size: 0.78rem;
  }
</style>
