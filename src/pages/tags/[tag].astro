---
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import PageHeader from "../../components/PageHeader.astro";
import { loadPostCatalog } from "../../lib/content";

export async function getStaticPaths() {
  const { tags } = await loadPostCatalog();
  return tags.map(({ slug, label, posts }) => ({
    params: { tag: slug },
    props: {
      tag: label,
      posts,
    },
  }));
}

const { tag, posts } = Astro.props;
---

<Base
  metadata={{
    kind: "page",
    title: `#${tag}`,
    description: `Posts tagged #${tag} on vakesz.com.`,
  }}
>
  <PageHeader eyebrow="Tag" title="#" accented={tag}>
    <Fragment slot="lede">
      {posts.length}{" "}
      {posts.length === 1 ? "post" : "posts"} tagged <code>{tag}</code>.
      <a href="/tags/">All tags →</a>
    </Fragment>
  </PageHeader>

  <div class="stack">
    {posts.map((post) => <PostCard post={post} headingLevel={2} />)}
  </div>
</Base>
