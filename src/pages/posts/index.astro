---
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import PageHeader from "../../components/PageHeader.astro";
import { loadPostCatalog } from "../../lib/content";

const { posts, years } = await loadPostCatalog();
---

<Base
  metadata={{
    kind: "page",
    title: "Posts",
    description:
      "All posts on vakesz.com - backend, automotive, career, and the occasional side project.",
  }}
>
  <PageHeader
    eyebrow="Writing"
    title="All"
    accented="posts."
    lede={`Everything I've written here, newest first. ${posts.length} total.`}
  />

  {
    years.map(({ year, posts: entries }) => (
      <section class="year-block">
        <h2 class="year">{year}</h2>
        <div class="stack">
          {entries.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      </section>
    ))
  }
</Base>

<style>
  .year-block {
    margin-top: 2rem;
  }
  .year {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 0.9rem;
  }
</style>
