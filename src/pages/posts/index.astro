---
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { loadPostCatalog } from "../../lib/content";
const { posts } = await loadPostCatalog();
---

<Base
  metadata={{
    kind: "page",
    title: "Blog",
    description: "Notes on software engineering, automotive systems, and a career built by doing.",
  }}
>
  <header class="page-header blog-header">
    <h1>Blog</h1>
    <a class="text-link" href="/rss.xml">
      RSS feed
    </a>
  </header>
  <div class="post-list">
    {posts.map((post) => (
      <PostCard post={post} headingLevel={2} />
    ))}
  </div>
  <p class="topics">
    <a class="text-link" href="/tags/">
      Browse by tag
    </a>
  </p>
</Base>
<style>
  .blog-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 2rem;
  }
  .blog-header h1 {
    margin-bottom: 0;
  }
  .topics {
    margin: 1.5rem 0 0;
  }
</style>
