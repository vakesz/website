---
import { render } from "astro:content";
import Post from "../../layouts/Post.astro";
import YouTube from "../../components/YouTube.astro";
import PostFooter from "../../components/PostFooter.astro";
import { loadPostCatalog } from "../../lib/content";

export async function getStaticPaths() {
  const catalog = await loadPostCatalog();
  return catalog.posts.map((post) => {
    const { prev, next } = catalog.neighborsOf(post.id);
    return {
      params: { slug: post.id },
      props: { post, prev, next },
    };
  });
}

const { post, prev, next } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
const minutesRead = remarkPluginFrontmatter?.minutesRead as number | undefined;
const wordCount = remarkPluginFrontmatter?.wordCount as number | undefined;
---

<Post
  title={post.data.title}
  description={post.data.description}
  slug={post.id}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  tags={post.data.tags}
  cover={post.data.cover}
  minutesRead={minutesRead}
  wordCount={wordCount}
>
  <Content components={{ YouTube }} />
  <PostFooter prev={prev} next={next} slot="after" />
</Post>
