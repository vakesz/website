---
import Base from "../layouts/Base.astro";
const cms = "https://app.pagescms.org/vakesz/vakesz/main";
const sections = [
  {
    title: "Blog posts",
    description: "Write a post, add a cover, or update something you’ve published.",
    href: `${cms}/collection/posts`,
    action: "Manage posts",
  },
  {
    title: "Projects",
    description: "Add projects, update screenshots, and choose your featured work.",
    href: `${cms}/collection/projects`,
    action: "Manage projects",
  },
  {
    title: "Homepage",
    description: "Update your name and the short introduction on your front page.",
    href: `${cms}/file/home`,
    action: "Edit homepage",
  },
  {
    title: "About page",
    description: "Keep your background, interests, and current work up to date.",
    href: `${cms}/file/about`,
    action: "Edit about",
  },
];
---

<Base
  metadata={{
    kind: "page",
    title: "Admin",
    description: "Manage content for vakesz.com with Pages CMS.",
    robots: "noindex",
  }}
>
  <a class="back-link" href="/">
    ← Back to website
  </a>
  <header class="admin-heading">
    <div>
      <h1>Admin</h1>
      <p class="lede">
        Write and edit with Pages CMS. Sign in with the GitHub account that has access to your site.
      </p>
    </div>
    <a class="btn btn-primary" href={`${cms}/collection/posts/new`}>
      Write a post ↗
    </a>
  </header>
  <div class="admin-grid">
    {sections.map((section) => (
      <a class="admin-card" href={section.href}>
        <>
          <h2>{section.title}</h2>
          <p>{section.description}</p>
          <span class="text-link">{section.action} ↗</span>
        </>
      </a>
    ))}
  </div>
  <section class="admin-info">
    <div>
      <h2>First visit?</h2>
      <p>
        Sign in with GitHub and give Pages CMS access to <strong>vakesz/vakesz</strong>. Each editor
        opens in Pages CMS.
      </p>
      <a
        class="text-link"
        href="https://pagescms.org/docs/quick-start/"
        target="_blank"
        rel="noopener noreferrer"
      >
        Pages CMS setup guide ↗
      </a>
    </div>
    <div>
      <h2>From draft to published</h2>
      <p>
        New posts start as drafts. When you’re ready, turn Draft off and save. Your connected
        Cloudflare project publishes after its next successful build.
      </p>
    </div>
  </section>
</Base>
<style>
  .admin-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    margin-bottom: 3rem;
  }
  .admin-heading h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
  }
  .admin-heading .lede {
    max-width: 52ch;
    margin-bottom: 0;
  }
  .admin-heading > .btn {
    white-space: nowrap;
  }
  .admin-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .admin-card {
    padding: 2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .admin-card:hover {
    border-color: var(--accent);
  }
  .admin-card h2 {
    font-size: 1.6rem;
    margin: 0 0 0.8rem;
  }
  .admin-card p {
    font-size: 1rem;
    color: var(--muted);
    max-width: 40ch;
    margin-bottom: 1rem;
  }
  .admin-info {
    border-top: 1px solid var(--border);
    padding-top: 2.5rem;
    margin-top: 3rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
  }
  .admin-info h2 {
    font-size: 1.2rem;
  }
  .admin-info p {
    color: var(--muted);
    font-size: 0.95rem;
  }
  @media (max-width: 760px) {
    .admin-heading {
      display: block;
    }
    .admin-heading > .btn {
      margin-top: 1.5rem;
    }
    .admin-grid,
    .admin-info {
      grid-template-columns: 1fr;
    }
    .admin-info {
      gap: 1.5rem;
    }
    .admin-card {
      padding: 1.5rem;
    }
  }
</style>
