---
import Base from "../../layouts/Base.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { loadProjects } from "../../lib/content";
const projects = await loadProjects();
---

<Base
  metadata={{
    kind: "page",
    title: "Projects",
    description: "Native apps, web tools, and open-source projects by Gábor Pinkova.",
  }}
>
  <header class="page-header portfolio-header">
    <h1>Projects</h1>
  </header>
  <div class="grid-2 portfolio-grid">
    {projects.map((project) => (
      <ProjectCard project={project} headingLevel={2} />
    ))}
  </div>
</Base>
<style>
  .portfolio-header h1 {
    margin-bottom: 0;
  }
  .portfolio-grid {
    row-gap: 3.5rem;
  }
</style>
