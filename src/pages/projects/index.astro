---
import Base from "../../layouts/Base.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import PageHeader from "../../components/PageHeader.astro";
import { loadProjects } from "../../lib/content";

const projects = await loadProjects();
---

<Base
  metadata={{
    kind: "page",
    title: "Projects",
    description: "Side projects, utilities, and works-in-progress by vakesz.",
  }}
  width="wide"
>
  <PageHeader
    eyebrow="Work"
    title="Selected"
    accented="projects."
    lede="Things I've built, mostly in my spare time. Some finished, some intentionally not."
  />

  <div class="grid-2">
    {projects.map((project) => <ProjectCard project={project} headingLevel={2} />)}
  </div>
</Base>
