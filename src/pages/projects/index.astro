---
import Base from "../../layouts/Base.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { loadProjects } from "../../lib/content";
const projects = await loadProjects();
---

<Base
  metadata={{
    kind: "page",
    title: "Portfolio",
    description: "Native apps, web tools, and open-source projects by Gábor Pinkova.",
  }}
  width="wide"
  ><header class="page-hero portfolio-header"><h1>Portfolio.</h1></header><div
    class="grid-2 portfolio-grid"
  >
    {projects.map((project) => <ProjectCard project={project} headingLevel={2} />)}
  </div></Base
>
<style>
  .portfolio-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 3rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 3rem;
  }
  .portfolio-header h1 {
    margin-bottom: 0;
  }
  .portfolio-header .lede {
    max-width: 34ch;
    margin-bottom: 0.3rem;
    font-size: 1.05rem;
  }
  .portfolio-grid {
    row-gap: 3.5rem;
  }
  @media (max-width: 760px) {
    .portfolio-header {
      display: block;
      padding-bottom: 2rem;
    }
    .portfolio-header .lede {
      margin: 1.5rem 0 0;
      max-width: 44ch;
    }
    .portfolio-header h1 br {
      display: none;
    }
  }
</style>
