---
import { getEntry, render } from "astro:content";
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import SocialLinks from "../components/SocialLinks.astro";
import aboutPhoto from "../assets/img/about-bike.jpg";

const entry = await getEntry("pages", "about");
if (!entry) throw new Error("Missing src/content/pages/about.mdx");
const { Content } = await render(entry);
const { title, description, lede } = entry.data;
---

<Base metadata={{ kind: "page", title, description }}>
  <section class="about-intro">
    <div class="about-photo">
      <Picture
        src={aboutPhoto}
        alt="Gábor with his mountain bike next to a mountain lake"
        widths={[360, 540, 768]}
        sizes="(max-width: 760px) 72vw, 340px"
        loading="eager"
        decoding="async"
        formats={["avif", "webp"]}
      />
    </div>

    <PageHeader title={title} lede={lede}>
      <div class="about-social">
        <SocialLinks />
      </div>
    </PageHeader>
  </section>

  <article class="prose">
    <Content />
  </article>
</Base>

<style>
  .about-intro {
    display: grid;
    grid-template-columns: minmax(220px, 340px) minmax(0, 1fr);
    gap: 2.5rem;
    align-items: start;
    margin: 0.5rem 0 2.5rem;
  }

  .about-intro :global(.page-header) {
    margin: 0;
    padding-top: 0.25rem;
  }

  .about-photo {
    width: min(340px, 100%);
    aspect-ratio: 4 / 5;
  }

  .about-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }

  article.prose {
    max-width: 65ch;
  }

  .about-social {
    margin-top: 1.4rem;
  }

  @media (max-width: 760px) {
    .about-intro {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      margin-bottom: 2rem;
    }

    .about-photo {
      width: min(260px, 72vw);
    }
  }
</style>
